# Maintainer environment variables
# Copy this file to .env and fill in real values from your secret stores.
# Nothing in this file should ever contain a real secret.

# --- Supabase ---
# Project: Maintainer (ref documented in supabase/README.md)
# Get values from the Supabase dashboard: Settings -> API
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- Anthropic ---
# Used by the GitHub Action and the orchestrator. BYO key.
ANTHROPIC_API_KEY=

# --- GitHub App (orchestrator only, not needed for the bare GitHub Action) ---
# Configured later when we wire up the App-token flow.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
