# Public values can be committed; secret values must not be.

# --- Supabase ---
# Project: Maintainer (ref: gpnsaswidreusgkyemvi)
# These are PUBLIC; safe to ship to the browser via NEXT_PUBLIC_ prefixes
# in the dashboard.
SUPABASE_URL=https://gpnsaswidreusgkyemvi.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_9vOzCIDCR9B3oyyrOmE5qg_uwWVDhRt

# Server-only. Do NOT commit. Set in your local .env or in Vercel/GitHub
# Actions secrets. Get this from the Supabase dashboard:
# https://supabase.com/dashboard/project/gpnsaswidreusgkyemvi/settings/api
SUPABASE_SECRET_KEY=

# --- Anthropic ---
# Used by the GitHub Action and the orchestrator. BYO key.
ANTHROPIC_API_KEY=

# --- GitHub App (orchestrator only, not needed for the bare GitHub Action) ---
